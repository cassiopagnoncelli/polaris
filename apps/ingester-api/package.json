{
  "name": "@polaris/ingester-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Polaris ingester API: thin Fastify ingress service for SDK and trusted producer events. Owns API key auth, project/environment resolution, schema validation, forbidden-field policy, short-window dedupe, and Redpanda publish.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "POLARIS_SERVICE_NAME=ingester-api POLARIS_HTTP_PORT=4000 tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@polaris/policy-catalog": "workspace:*",
    "@polaris/runtime-config": "workspace:*",
    "@polaris/persistence-postgres": "workspace:*",
    "@polaris/bus": "workspace:*",
    "@polaris/runtime-environments": "workspace:*",
    "@polaris/observability-logger": "workspace:*",
    "@polaris/tenancy-project-config": "workspace:*",
    "@polaris/observability-metrics": "workspace:*",
    "@polaris/governance": "workspace:*",
    "@polaris/spec": "workspace:*",
    "@polaris/runtime-secrets": "workspace:*",
    "@polaris/runtime-service-bootstrap": "workspace:*",
    "fastify": "^5.8.5",
    "ioredis": "^5.4.2",
    "kysely": "^0.29.0",
    "zod": "^4.4.3"
  }
}
