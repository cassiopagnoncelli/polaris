{
  "name": "@polaris/polaris-cli",
  "version": "0.0.0",
  "private": true,
  "description": "Polaris control-plane CLI \u2014 thin client that talks to apps/control-plane-api over HTTPS using env-var bearer auth.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "polaris": "./dist/bin/polaris.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@polaris/audience-catalog": "workspace:*",
    "@polaris/policy-catalog": "workspace:*",
    "@polaris/processor-audiences-v1": "workspace:*",
    "@polaris/processor-reverse-etl-v1": "workspace:*",
    "@polaris/processor-traits-v1": "workspace:*",
    "@polaris/project-config-schemas": "workspace:*",
    "@polaris/reverse-etl-catalog": "workspace:*",
    "@polaris/shared-archive": "workspace:*",
    "@polaris/shared-clickhouse": "workspace:*",
    "@polaris/shared-config": "workspace:*",
    "@polaris/shared-control-plane": "workspace:*",
    "@polaris/shared-control-plane-db": "workspace:*",
    "@polaris/shared-db": "workspace:*",
    "@polaris/shared-destinations": "workspace:*",
    "@polaris/shared-environments": "workspace:*",
    "@polaris/shared-logger": "workspace:*",
    "@polaris/shared-policy": "workspace:*",
    "@polaris/shared-processor": "workspace:*",
    "@polaris/shared-replay": "workspace:*",
    "@polaris/shared-secrets": "workspace:*",
    "@polaris/shared-transport": "workspace:*",
    "@polaris/trait-catalog": "workspace:*",
    "commander": "^14.0.2",
    "kysely": "^0.29.0",
    "smol-toml": "^1.5.0",
    "uuid": "^14.0.0",
    "yaml": "^2.6.1",
    "zod": "4.4.3"
  }
}
