{
  "name": "@polaris/consumer-braze-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Polaris Braze destination consumer v1. Maps canonical Polaris events into Braze's REST /users/track payload shape (attributes/events/purchases arrays keyed by external_id) and POSTs them to rest.<instance>.braze.com/users/track with Authorization: Bearer header auth. Third real-vendor consumer; relies on Polaris-side delivery-key idempotency because Braze does not provide a generic vendor event dedupe.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "consumer.manifest.yaml",
    "SPEC.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "POLARIS_SERVICE_NAME=braze POLARIS_HTTP_PORT=5004 tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@polaris/shared-config": "workspace:*",
    "@polaris/shared-destination-normalize": "workspace:*",
    "@polaris/shared-destinations": "workspace:*",
    "@polaris/shared-db": "workspace:*",
    "@polaris/shared-transport": "workspace:*",
    "@polaris/shared-logger": "workspace:*",
    "@polaris/shared-metrics": "workspace:*",
    "@polaris/shared-secrets": "workspace:*",
    "@polaris/shared-service-bootstrap": "workspace:*",
    "kysely": "^0.29.0",
    "zod": "^4.4.3"
  }
}
