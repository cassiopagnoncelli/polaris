{
  "name": "@polaris/consumer-webhook-sink-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Polaris webhook-sink destination consumer v1. The simplest vendor: POST canonical events as JSON to a configurable HTTPS endpoint with an optional HMAC-SHA256 signature header. Serves as the canonical exemplar for vendor consumers (Meta CAPI, GA4, TikTok, Braze) landing later.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "consumer.manifest.yaml",
    "SPEC.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "POLARIS_SERVICE_NAME=webhook-sink POLARIS_HTTP_PORT=5000 tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@polaris/shared-config": "workspace:*",
    "@polaris/shared-destination-normalize": "workspace:*",
    "@polaris/shared-destinations": "workspace:*",
    "@polaris/shared-db": "workspace:*",
    "@polaris/shared-transport": "workspace:*",
    "@polaris/shared-logger": "workspace:*",
    "@polaris/shared-metrics": "workspace:*",
    "@polaris/shared-service-bootstrap": "workspace:*",
    "kysely": "^0.29.0",
    "zod": "^4.4.3"
  }
}
