{
  "name": "@polaris/processor-archiver-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Polaris archiver v1. Consumes raw.events and writes size- and age-bounded partitioned NDJSON to object storage, holding the consumer checkpoint back to the last durably-archived offset so a crash loses nothing. The archive is what lets a profile rebuild reach past the stream's 90-day retention.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "processor.manifest.yaml"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "POLARIS_SERVICE_NAME=archiver POLARIS_HTTP_PORT=4022 tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@polaris/archive-writer": "workspace:*",
    "@polaris/runtime-config": "workspace:*",
    "@polaris/persistence-postgres": "workspace:*",
    "@polaris/observability-logger": "workspace:*",
    "@polaris/observability-metrics": "workspace:*",
    "@polaris/pipeline": "workspace:*",
    "@polaris/runtime-service-bootstrap": "workspace:*",
    "@polaris/bus": "workspace:*",
    "kysely": "^0.29.0",
    "zod": "^4.4.3"
  }
}
