{
  "name": "@polaris/processor-journey-orchestrator-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "processor.manifest.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "POLARIS_SERVICE_NAME=journey-orchestrator POLARIS_HTTP_PORT=4023 tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@polaris/audience-catalog": "workspace:*",
    "@polaris/journey-catalog": "workspace:*",
    "@polaris/shared-db": "workspace:*",
    "@polaris/shared-logger": "workspace:*",
    "kysely": "^0.29.0",
    "uuid": "^13.0.0",
    "@polaris/shared-config": "workspace:*",
    "@polaris/shared-metrics": "workspace:*",
    "@polaris/shared-processor": "workspace:*",
    "@polaris/shared-service-bootstrap": "workspace:*",
    "@polaris/shared-transport": "workspace:*"
  }
}
