{
  "name": "@polaris/processor-merge-worker-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Polaris merge-worker v1. Consumes profile.events, acts on identity.merged, and keeps polaris.profile_merge_map current so person-keyed ClickHouse reads resolve a tombstoned profile to its survivor. Transitive chains collapse at write time, because a dictionary lookup cannot iterate.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "processor.manifest.yaml"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "POLARIS_SERVICE_NAME=merge-worker POLARIS_HTTP_PORT=4021 tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@polaris/persistence-clickhouse": "workspace:*",
    "kysely": "^0.29.0",
    "@polaris/runtime-config": "workspace:*",
    "@polaris/persistence-postgres": "workspace:*",
    "@polaris/observability-logger": "workspace:*",
    "@polaris/observability-metrics": "workspace:*",
    "@polaris/pipeline": "workspace:*",
    "@polaris/spec": "workspace:*",
    "@polaris/runtime-service-bootstrap": "workspace:*",
    "@polaris/bus": "workspace:*",
    "ioredis": "^5.4.2",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  }
}
