{
  "name": "@polaris/processor-sessionizer-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Polaris sessionizer processor v1. Consumes raw.events, maintains an in-memory inactivity window per (project_id, environment, primary_identifier), and emits session.started / session.ended events on session.events. SDK session_id is treated as a hint, not authoritative.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "processor.manifest.yaml",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "POLARIS_SERVICE_NAME=sessionizer POLARIS_HTTP_PORT=4012 tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@polaris/runtime-config": "workspace:*",
    "@polaris/persistence-postgres": "workspace:*",
    "@polaris/observability-logger": "workspace:*",
    "@polaris/observability-metrics": "workspace:*",
    "@polaris/pipeline": "workspace:*",
    "@polaris/spec": "workspace:*",
    "@polaris/runtime-service-bootstrap": "workspace:*",
    "@polaris/bus": "workspace:*",
    "ioredis": "^5.4.2",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  }
}
