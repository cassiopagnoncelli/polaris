{
  "name": "@polaris/processor-attribution-engine-v3",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Polaris attribution engine v3. Consumes resolved.events and keys attribution_touchpoint_chains on profile_id, so a chain follows the PERSON: touchpoints collected while anonymous stay on the same chain as the purchase made after login. Rows are disjoint from v1/v2 by processor_version in the primary key.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "processor.manifest.yaml",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "POLARIS_SERVICE_NAME=attribution-engine POLARIS_HTTP_PORT=4020 tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@polaris/runtime-config": "workspace:*",
    "@polaris/persistence-postgres": "workspace:*",
    "@polaris/observability-logger": "workspace:*",
    "@polaris/observability-metrics": "workspace:*",
    "@polaris/pipeline": "workspace:*",
    "@polaris/spec": "workspace:*",
    "@polaris/runtime-service-bootstrap": "workspace:*",
    "@polaris/bus": "workspace:*",
    "kysely": "^0.29.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  }
}
