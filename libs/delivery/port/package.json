{
  "name": "@polaris/delivery-port",
  "version": "0.0.0",
  "private": true,
  "description": "The destination.port contract: what a vendor connector under connectors/destinations/ declares (slug, supported modes, map, deliver) and the bridge that binds one to the shared destination runtime. Types and pure functions only. No network. No I/O. No vendor knowledge.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage .tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@polaris/delivery-destinations": "workspace:*",
    "@polaris/delivery-normalize": "workspace:*",
    "zod": "^4.4.3"
  }
}
