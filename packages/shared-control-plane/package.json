{
  "name": "@polaris/shared-control-plane",
  "version": "0.0.0",
  "private": true,
  "description": "Polaris control-plane shared primitives: operator identity / actor resolution and the production-mutation dispatcher gate. Reused by the polaris CLI today and the future control-plane API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage .tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@polaris/shared-environments": "workspace:*",
    "@polaris/shared-secrets": "workspace:*"
  }
}
