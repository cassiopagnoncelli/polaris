{
  "name": "@polaris/shared-kafka",
  "version": "0.0.0",
  "private": true,
  "description": "Thin KafkaJS wrapper for Polaris: producer/consumer factories, topic-family resolution, partition keys, headers, event serialization, retry defaults, and DLQ helpers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./topics": {
      "types": "./dist/topics.d.ts",
      "import": "./dist/topics.js"
    },
    "./partition-key": {
      "types": "./dist/partition-key.d.ts",
      "import": "./dist/partition-key.js"
    },
    "./headers": {
      "types": "./dist/headers.d.ts",
      "import": "./dist/headers.js"
    },
    "./serialization": {
      "types": "./dist/serialization.d.ts",
      "import": "./dist/serialization.js"
    },
    "./dlq": {
      "types": "./dist/dlq.d.ts",
      "import": "./dist/dlq.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage .tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@polaris/shared-config": "workspace:*",
    "@polaris/shared-logger": "workspace:*",
    "kafkajs": "^2.2.4"
  }
}
