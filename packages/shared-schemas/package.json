{
  "name": "@polaris/shared-schemas",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical event envelope, per-event Zod property schemas, and file-backed event catalog loader for Polaris.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./envelope": {
      "types": "./dist/envelope/index.d.ts",
      "import": "./dist/envelope/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./reason-codes": {
      "types": "./dist/reason-codes.d.ts",
      "import": "./dist/reason-codes.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@polaris/shared-environments": "workspace:*",
    "yaml": "^2.6.1",
    "zod": "^4.4.3"
  }
}
