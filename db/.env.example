# Polaris PostgreSQL migration environment.
#
# This file is a template. To customize migration credentials locally,
# source it into your shell or copy a working version into your shell rc:
#
#   set -a; source db/.env.example; set +a
#   pnpm db:status
#
# The pnpm `db:*` scripts at the repo root default `DATABASE_URL` to the
# local compose stack value below, so they work out of the box without any
# environment configuration. Override only when you need a non-default
# host, port, or credentials.
#
# Never commit a file containing real credentials. Gitignore policy for
# .env* is owned by task P11-006.

# Connection URL for the local compose stack (see docker-compose.yml).
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
DATABASE_URL=postgres://polaris:polaris@localhost:5432/polaris?sslmode=disable
