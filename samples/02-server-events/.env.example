# Copy to `.env.local`, then fill in a key issued for a *backend* source:
#
#   node apps/polaris-cli/dist/bin/polaris.js keys create \
#     --project storefront --env development --source payments-api --type backend
#
# No NEXT_PUBLIC_ prefix: these values stay on the server. A backend key is a
# secret — it is not origin-scoped and not rate-limited the way a web key is.
POLARIS_ENDPOINT=http://localhost:4000/v1/events
POLARIS_API_KEY=
POLARIS_SOURCE_ID=payments-api
