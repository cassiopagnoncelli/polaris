# Copy to `.env.local`, then fill in a key issued for a *web* source:
#
#   node apps/polaris-cli/dist/bin/polaris.js keys create \
#     --project storefront --env development --source storefront-web --type web
#
# NEXT_PUBLIC_* values are inlined into the browser bundle. That is correct
# here: a web key is publishable, and the ingester defends it with the origin
# allow-list and per-key rate limits. Never put a backend key in one of these.
NEXT_PUBLIC_POLARIS_ENDPOINT=http://localhost:4000/v1/events
NEXT_PUBLIC_POLARIS_API_KEY=
NEXT_PUBLIC_POLARIS_SOURCE_ID=storefront-web
