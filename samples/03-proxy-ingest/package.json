{
  "name": "polaris-sample-proxy-ingest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Polaris sample: browser events relayed through a first-party Next.js route so the API key never leaves the server.",
  "scripts": {
    "dev": "node ../preflight-watch-capacity.mjs && next dev --port 3643",
    "build": "next build",
    "start": "next start --port 3643",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@polaris/web-sdk": "link:../../packages/web-sdk",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "6.0.3"
  }
}
