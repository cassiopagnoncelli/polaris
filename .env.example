# =============================================================================
# Polaris production runtime configuration — variable inventory
# =============================================================================
#
# WHAT THIS FILE IS
#   Every `POLARIS_*` environment variable a Polaris service may read at
#   runtime, grouped by the component that owns it. The values are
#   placeholders — production hosts MUST inject real values through their
#   environment / secret-injection layer (see docs/deployment/README.md).
#
# WHAT THIS FILE IS NOT
#   - a place for plaintext secrets. Every secret-bearing variable is
#     marked `# OBTAIN FROM <provider>` and left empty.
#   - semantic configuration. Event schemas, catalog declarations,
#     destination mappings, and processor wiring live in versioned
#     files under `catalog/`, `packages/event-catalog/`, processor
#     directories, and consumer descriptors. They are NOT runtime config
#     and are not toggled through environment variables.
#   - the source of truth. The Zod schemas in
#     `packages/shared-config/src/schemas/` define which variables are
#     required and what they accept. This file documents those schemas;
#     if it drifts, the schemas win.
#
# LAYOUT
#   The shared-infra section covers variables every service reads. Each
#   per-service section lists ONLY the extra variables that service
#   adds on top. A `consumer-x` deployment, for instance, reads the
#   shared-infra block PLUS its own block. Variables flagged `required`
#   throw at startup if missing; everything else has a sensible default
#   inside the Zod schema.
#
# LOCAL DEVELOPMENT
#   Copy this file to `.env.local` or `.env.development` and fill in
#   values for the local Docker-compose stack
#   (`docker-compose.yml`, `docker-compose.observability.yml`). The
#   shared-config loader merges `.env.local` over `.env.<env>`, which
#   is fine for development. PRODUCTION DEPLOYMENTS MUST NOT SHIP A
#   `.env` FILE — they inject every variable through the orchestrator
#   so the platform never reads a file from disk on a production host.
#
# =============================================================================
# Shared service identity (every Polaris service reads these)
# =============================================================================

# Short identifier emitted on logs, metrics labels, and the /health body.
# Each Dockerfile sets a default matching the directory name; override only
# to disambiguate horizontally scaled deployments.
POLARIS_SERVICE_NAME=ingester-api

# Build-stamped semver-ish label. The container build sets this from
# `git describe --tags --always`; production deployments usually leave it
# alone.
POLARIS_SERVICE_VERSION=0.0.0

# Polaris deployment environment. One of: local | development | staging | production.
# REQUIRED. Drives label cardinality on every metric and log line and gates
# the CLI's "production mutation requires authenticated actor" rule.
POLARIS_ENV=production

# Pino log level: fatal | error | warn | info | debug | trace. Defaults to `info`.
POLARIS_LOG_LEVEL=info

# When true, Pino formats stdout for human reading. Defaults to true only when
# POLARIS_ENV=local; production should leave this false so logs stay JSON.
POLARIS_LOG_PRETTY=false

# Build metadata stamped into /health. Set by `infra/docker/*` build args.
POLARIS_GIT_SHA=
POLARIS_BUILD_TIME=

# =============================================================================
# Shared HTTP server (ingester-api, control-plane-api, processors, consumers)
# =============================================================================

# Bind host. `0.0.0.0` inside containers; do not override unless binding
# to a specific interface.
POLARIS_HTTP_HOST=0.0.0.0

# Listener port. The Dockerfile per service sets a service-canonical default
# (see infra/docker/README.md). Override only to relocate the listener.
POLARIS_HTTP_PORT=4000

# Max request body size in bytes. Defaults to 1 MiB (1048576).
POLARIS_HTTP_BODY_LIMIT_BYTES=1048576

# Per-request total timeout in milliseconds. Defaults to 15000 (15 s).
POLARIS_HTTP_REQUEST_TIMEOUT_MS=15000

# Keep-alive timeout in milliseconds. Defaults to 5000 (5 s).
POLARIS_HTTP_KEEPALIVE_TIMEOUT_MS=5000

# =============================================================================
# PostgreSQL (ingester-api, control-plane-api, processors, consumers, CLI)
# =============================================================================

# Hostname of the PostgreSQL primary. REQUIRED.
POLARIS_POSTGRES_HOST=postgres.internal

# Port. Defaults to 5432.
POLARIS_POSTGRES_PORT=5432

# Database name. REQUIRED.
POLARIS_POSTGRES_DATABASE=polaris

# Username. REQUIRED. Production should provision a least-privilege role
# per service tier where practical.
POLARIS_POSTGRES_USER=polaris

# Password. REQUIRED. # OBTAIN FROM vault (path: polaris/<env>/postgres)
# Production injects this through the secret provider (P11-004); never
# commit a real value.
POLARIS_POSTGRES_PASSWORD=

# Enable TLS to PostgreSQL. Defaults to false; set true in production.
POLARIS_POSTGRES_SSL=true

# Max pool size. Defaults to 10. Tune per service throughput.
POLARIS_POSTGRES_POOL_MAX=10

# Connect timeout, milliseconds. Defaults to 10000 (10 s).
POLARIS_POSTGRES_CONNECT_TIMEOUT_MS=10000

# Idle connection timeout, milliseconds. Defaults to 30000 (30 s).
POLARIS_POSTGRES_IDLE_TIMEOUT_MS=30000

# CLI-only convenience: a full PostgreSQL connection URL used by the
# `polaris` CLI's catalog/audit commands. Falls back to `DATABASE_URL`.
# Operators usually set this once on bastion hosts; services use the
# per-field POLARIS_POSTGRES_* variables above.
POLARIS_DATABASE_URL=

# =============================================================================
# Redis (ingester-api only in v1; processors may opt in later)
# =============================================================================

# Hostname of the Redis primary. REQUIRED for the ingester (dedupe and
# rate-limit live here). Other services do not connect.
POLARIS_REDIS_HOST=redis.internal

# Port. Defaults to 6379.
POLARIS_REDIS_PORT=6379

# Logical DB index, 0..15. Defaults to 0.
POLARIS_REDIS_DB=0

# Username. Optional unless the Redis ACL requires one.
POLARIS_REDIS_USERNAME=

# Password. # OBTAIN FROM vault (path: polaris/<env>/redis)
# Optional. Production should authenticate.
POLARIS_REDIS_PASSWORD=

# Connect timeout, milliseconds. Defaults to 5000 (5 s).
POLARIS_REDIS_CONNECT_TIMEOUT_MS=5000

# Optional key prefix for namespacing across multi-tenant Redis. Not used
# by the ingester runtime, which has its own per-feature prefixes
# (POLARIS_INGEST_REDIS_KEY_PREFIX, POLARIS_RATE_LIMIT_REDIS_KEY_PREFIX).
POLARIS_REDIS_KEY_PREFIX=

# =============================================================================
# RabbitMQ (ingester-api, processors, consumers — anything on the event path)
# =============================================================================

# AMQP connection URL, credentials included. REQUIRED.
# Use amqps:// in production. # OBTAIN FROM vault (path: polaris/<env>/rabbitmq)
POLARIS_RABBITMQ_URL=amqps://polaris-ingester:@rabbitmq.internal:5671/polaris

# HTTP management API base URL. Optional; used by provisioning and
# operational tooling only, never on the data path.
POLARIS_RABBITMQ_MANAGEMENT_URL=https://rabbitmq.internal:15671

# Connection name shown in the management UI. REQUIRED. Set it to the
# service name so broker-side connection lists are attributable.
POLARIS_RABBITMQ_CLIENT_ID=ingester-api

# Enable TLS verification options. Defaults to false; set true in
# production. Rejected at config load if the URL is plaintext amqp://.
POLARIS_RABBITMQ_TLS=true

# AMQP heartbeat, seconds. Defaults to 30.
POLARIS_RABBITMQ_HEARTBEAT_SECONDS=30

# Connection timeout, milliseconds. Defaults to 10000 (10 s).
POLARIS_RABBITMQ_CONNECTION_TIMEOUT_MS=10000

# Default super-stream width (partitions per family). Defaults to 3.
# CHANGING THIS IS A MIGRATION, not a restart: the publisher hashes the
# partition key modulo this number, so a mismatch between two running
# instances breaks per-identity ordering. See
# docs/operations/runbook-rabbitmq-topology.md.
POLARIS_RABBITMQ_PARTITIONS=3

# Per-family width overrides, `<family>=<count>` comma-separated.
# raw.events carries every project's firehose and is wider by default.
POLARIS_RABBITMQ_PARTITION_OVERRIDES=raw.events=6,identified.events=6,resolved.events=6

# Static partition assignment for THIS instance, comma-separated. Empty
# means "own every partition", which is correct for single-instance
# deployments. Scaling a processor out means giving each replica a
# disjoint slice — RabbitMQ has no consumer-group rebalancing, so the
# split is explicit and operator-owned.
POLARIS_RABBITMQ_ASSIGNED_PARTITIONS=

# Per-partition prefetch (QoS window). Defaults to 100. Controls how far
# the broker runs ahead, NOT handler concurrency — handlers are strictly
# serial per partition so per-identity ordering holds.
POLARIS_RABBITMQ_PREFETCH=100

# Checkpoint flush cadence. The consumer writes its offset to
# `transport_checkpoints` after this many messages OR this much elapsed
# time, whichever comes first, plus a forced flush on shutdown. Larger
# values mean fewer Postgres writes and more redelivery after a crash.
POLARIS_RABBITMQ_CHECKPOINT_EVERY=500
POLARIS_RABBITMQ_CHECKPOINT_INTERVAL_MS=5000

# Stream retention, days. Applied as `x-max-age` at declaration time and
# therefore only takes effect on streams that do not exist yet.
POLARIS_RABBITMQ_STREAM_RETENTION_DAYS=90

# =============================================================================
# ClickHouse (CLI/operator commands; future analytics services)
# =============================================================================

# Full HTTP URL including scheme. REQUIRED for any service that queries
# ClickHouse. Not used by the ingester or the per-destination consumers.
POLARIS_CLICKHOUSE_URL=https://clickhouse.internal:8443

# Database name. REQUIRED.
POLARIS_CLICKHOUSE_DATABASE=polaris

# Service-role credentials (SELECT-only on projection tables +
# analytics_ingest_log). REQUIRED.
POLARIS_CLICKHOUSE_SERVICE_USER=polaris_service
# OBTAIN FROM vault (path: polaris/<env>/clickhouse/service)
POLARIS_CLICKHOUSE_SERVICE_PASSWORD=

# Operator-role credentials (broader access for replay / rebuild jobs).
# Set as a pair or leave both blank. Required by CLI operator commands;
# services should leave this unset.
POLARIS_CLICKHOUSE_OPERATOR_USER=
# OBTAIN FROM vault (path: polaris/<env>/clickhouse/operator)
POLARIS_CLICKHOUSE_OPERATOR_PASSWORD=

# Per-request timeout, milliseconds. Defaults to 30000 (30 s).
POLARIS_CLICKHOUSE_REQUEST_TIMEOUT_MS=30000

# Max open connections. Defaults to 10.
POLARIS_CLICKHOUSE_MAX_OPEN_CONNECTIONS=10

# =============================================================================
# Ingester API (apps/ingester-api/src/config.ts)
# =============================================================================

# In-process API-key cache size. Defaults to 1024 entries.
POLARIS_AUTH_CACHE_MAX_ENTRIES=1024

# Positive-result cache TTL, milliseconds. Defaults to 60000 (60 s).
POLARIS_AUTH_CACHE_TTL_MS=60000

# Negative-result cache TTL, milliseconds (caches "unknown key" too).
# Defaults to 5000 (5 s).
POLARIS_AUTH_CACHE_NEGATIVE_TTL_MS=5000

# Default ingress dedupe window in seconds. Defaults to 900 (15 min).
POLARIS_INGEST_DEDUPE_DEFAULT_WINDOW_SEC=900

# Hard cap on per-project dedupe window in seconds. Defaults to 86400 (24 h).
POLARIS_INGEST_DEDUPE_MAX_WINDOW_SEC=86400

# NOTE: per-project dedupe windows moved to project configuration. Set them with
#   polaris config set --project <id> --env <env> --namespace ingest \
#     --key dedupe_window_sec --value 3600 --reason "..."
# The MAX above stays here: it is the ceiling a project may opt in up to, so a
# project must not be able to raise its own.

# Redis key prefix for the dedupe store. Defaults to `polaris:ingest:dedupe`.
POLARIS_INGEST_REDIS_KEY_PREFIX=polaris:ingest:dedupe

# Short deadline applied to the dedupe SETNX call, milliseconds.
# Defaults to 50.
POLARIS_INGEST_REDIS_OP_TIMEOUT_MS=50

# Max events allowed in a single ingest batch. Defaults to 1000.
POLARIS_INGEST_MAX_BATCH_EVENTS=1000

# Per-API-key request budget, requests per second. 0 disables the limiter
# (fail-open). Defaults to 1000.
POLARIS_RATE_LIMIT_PER_API_KEY_RPS=1000

# Sliding rate-limit window, seconds. Defaults to 1.
POLARIS_RATE_LIMIT_WINDOW_SECONDS=1

# NOTE: per-project rate limits moved to project configuration. Set them with
#   polaris config set --project <id> --env <env> --namespace ingest \
#     --key rate_limit_rps --value 5000 --reason "..."

# Redis key prefix for the rate limiter. Defaults to `polaris:ingest:rl`.
POLARIS_RATE_LIMIT_REDIS_KEY_PREFIX=polaris:ingest:rl

# Short deadline applied to the rate-limiter Redis call, milliseconds.
# Defaults to 50.
POLARIS_RATE_LIMIT_REDIS_OP_TIMEOUT_MS=50

# =============================================================================
# Processor: analytics-projector v1
# (sync/legacy/analytics-projector/v1/src/config.ts)
# =============================================================================

# KafkaJS consumer group. Defaults to `polaris-analytics-projector-v1`.
POLARIS_ANALYTICS_PROJECTOR_CONSUMER_GROUP=polaris-analytics-projector-v1

# `partitionsConsumedConcurrently`. Defaults to 1.
# (A `_CONCURRENCY` knob used to be documented here. No schema ever read
# it: a processor's parallelism is its partition count, because the
# consumer handles one message at a time per partition to preserve
# per-key order. Setting it did nothing, silently.)

# =============================================================================
# Processor: identity-resolver v1
# (sync/legacy/identity-resolver/v1/src/config.ts)
# =============================================================================

POLARIS_IDENTITY_RESOLVER_CONSUMER_GROUP=polaris-identity-resolver-v1
# (A `_CONCURRENCY` knob used to be documented here. No schema ever read
# it: a processor's parallelism is its partition count, because the
# consumer handles one message at a time per partition to preserve
# per-key order. Setting it did nothing, silently.)

# =============================================================================
# Stage: sync-identity (identity resolver v1)
# (sync/identity/resolver/v1/src/config.ts)
# =============================================================================

POLARIS_SYNC_IDENTITY_CONSUMER_GROUP=polaris-sync-identity-v1

# Directory containing `catalog/projects/`, whose `identity:` blocks hold
# the per-project denylist and narrowed semantic parameters. "." in the
# container (the image copies the catalog under /app); the repo root when
# running from a checkout.
POLARIS_SYNC_IDENTITY_CATALOG_ROOT=.

# =============================================================================
# Stage: sync-enrichment (enrichment runtime v1)
# (sync/enrichment/runtime/v1/src/config.ts)
# =============================================================================

POLARIS_SYNC_ENRICHMENT_CONSUMER_GROUP=polaris-sync-enrichment-v1

# Same contract as the identity stage's: the directory holding
# `catalog/projects/`, whose `enrichment:` blocks narrow the traits
# snapshot guard.
POLARIS_SYNC_ENRICHMENT_CATALOG_ROOT=.

# MaxMind GeoLite2 database. UNSET is a supported production posture, not
# a misconfiguration: the file is license-restricted and lives outside
# the image, so a deployment that has not provisioned it yet still runs —
# every geo block simply reads `source: "no_lookup"`. Provision it with
# infra/geoip/refresh-geoip.sh and point this at the result.
# POLARIS_SYNC_ENRICHMENT_GEOIP_DB_PATH=/etc/polaris/geoip/GeoLite2-City.mmdb

# =============================================================================
# Processor: sessionizer v1 AND v2
# (async/computation/sessionizer/{v1,v2}/src/config.ts)
# =============================================================================
#
# TWO VERSIONS, ONE SET OF ENV VAR NAMES. v1 keys session windows on
# whichever identifier an event carried; v2 keys them on the person the
# identity stage resolved, which is what stops a login ending one session
# and orphaning it. They run side by side until R2C retires v1.
#
# The env var names are shared because both read the same config module
# shape, and the DEFAULTS differ per version (`polaris-sessionizer-v1` vs
# `-v2`). That is fine when each process gets its own environment — a
# container, a systemd unit — and WRONG in a shared shell that exports
# one value for both: setting POLARIS_SESSIONIZER_CONSUMER_GROUP once
# would collapse the two versions into one consumer group, so they would
# split the partitions between them and each would see half the events.
# Every window either version opened would then be missing the events
# that should have continued it.
#
#   * Per-process env (containers, compose, systemd): leave both unset
#     and let each version take its own default. This is the normal case.
#   * One shared env for both: do not set this variable. If you must,
#     set it per process, never globally.
#
# The retry/DLQ component is likewise shared (`sessionizer.*` queues),
# matching how attribution v1/v2 coexist today. A poison message cannot
# be attributed to a version from the queue alone — read
# `processor_version` off the DLQ record, which every dead-letter carries.
POLARIS_SESSIONIZER_CONSUMER_GROUP=polaris-sessionizer-v1
# (A `_CONCURRENCY` knob used to be documented here. No schema ever read
# it: a processor's parallelism is its partition count, because the
# consumer handles one message at a time per partition to preserve
# per-key order. Setting it did nothing, silently.)

# Session inactivity timeout, seconds. Defaults to 1800 (30 min).
# NOTE: this is SEMANTIC. The runtime ignores attempts to widen it
# beyond the manifest default — bumping inactivity requires a v2 processor
# (see processor manifest), not an env var change.
POLARIS_SESSIONIZER_INACTIVITY_SECONDS=1800

# Session state lives in Redis (ADR 0005), keyed under this prefix and
# expiring after the inactivity window above. The sessionizer uses the
# shared POLARIS_REDIS_* connection settings; only the namespace and the
# per-call deadline are its own.
#
# The prefix is deliberately distinct from the ingester's dedupe prefix so
# the two cannot collide in a shared Redis.
POLARIS_SESSIONIZER_REDIS_KEY_PREFIX=polaris:session

# Hard deadline per Redis call, ms. Unlike the ingester's dedupe store, a
# timeout here FAILS the message rather than degrading — the sessionizer
# cannot tell a continuation from a new session without the prior record,
# so it stalls rather than guessing. This bounds how long a sick Redis
# takes to become a redelivery instead of a hang.
POLARIS_SESSIONIZER_REDIS_OP_TIMEOUT_MS=250

# =============================================================================
# Processor: geoip-enricher v1
# (sync/legacy/geoip-enricher/v1/src/config.ts)
# =============================================================================

POLARIS_GEOIP_ENRICHER_CONSUMER_GROUP=polaris-geoip-enricher-v1
# (A `_CONCURRENCY` knob used to be documented here. No schema ever read
# it: a processor's parallelism is its partition count, because the
# consumer handles one message at a time per partition to preserve
# per-key order. Setting it did nothing, silently.)

# Path to a mounted MaxMind GeoLite2 database file. The v1 enricher
# does not read this — the file is mounted at runtime per
# `infra/docker/README.md`. The follow-up task that wires the MaxMind
# adapter will start reading it.
# (`POLARIS_GEOIP_DB_PATH` used to be documented here as "reserved".
# Nothing read it, and the geoip-enricher's own config module carries a
# comment saying so — which is how it survived a scan that counted any
# mention as a use. The enrichment stage reads
# `POLARIS_SYNC_ENRICHMENT_GEOIP_DB_PATH`, which is the live one.)

# =============================================================================
# Processor: attribution-engine (v1 and v2)
# (async/computation/attribution-engine/v{1,2}/src/config.ts)
# =============================================================================
#
# v2 adds a 90-day attribution window; v1 has none. Both read the same env
# vars, so a deployment sets the consumer group to match the version it runs
# — the defaults differ (`...-v1` / `...-v2`) precisely so a cutover starts
# from its own offsets instead of inheriting the other version's position.
#
# There is deliberately NO env var for the attribution window. It is a
# semantic rule and lives in the v2 manifest; changing it is a v3. See
# docs/architecture/05-processors-and-replay.md "Processor Versioning".

POLARIS_ATTRIBUTION_ENGINE_CONSUMER_GROUP=polaris-attribution-engine-v2
# (A `_CONCURRENCY` knob used to be documented here. No schema ever read
# it: a processor's parallelism is its partition count, because the
# consumer handles one message at a time per partition to preserve
# per-key order. Setting it did nothing, silently.)

# =============================================================================
# Consumer: webhook-sink v1
# (sync/destinations/webhook-sink/v1/src/config.ts)
# =============================================================================

POLARIS_WEBHOOK_SINK_CONSUMER_GROUP=polaris-webhook-sink-v1
# (A `_CONCURRENCY` knob used to be documented here. It moved to the
# `destinations.max_concurrency` column, per instance, when destinations
# became rows rather than deployments — one vendor can now have two
# instances with different limits, which a deployment-wide variable
# cannot express. Setting the old one did nothing, silently.)

# Per-attempt HTTP fetch timeout, milliseconds. Defaults to 5000.
POLARIS_WEBHOOK_SINK_REQUEST_TIMEOUT_MS=5000

# When true, replay traffic (events with the `polaris-replay` header)
# is delivered to the live destination. Defaults to false; flip via
# replay tooling, not deployment config.
POLARIS_WEBHOOK_SINK_ALLOW_REPLAY=false

# =============================================================================
# Consumer: meta-capi v1
# (sync/destinations/meta-capi/v1/src/config.ts)
# =============================================================================

POLARIS_META_CAPI_CONSUMER_GROUP=polaris-meta-capi-v1
# (A `_CONCURRENCY` knob used to be documented here. It moved to the
# `destinations.max_concurrency` column, per instance, when destinations
# became rows rather than deployments — one vendor can now have two
# instances with different limits, which a deployment-wide variable
# cannot express. Setting the old one did nothing, silently.)
POLARIS_META_CAPI_REQUEST_TIMEOUT_MS=5000
POLARIS_META_CAPI_ALLOW_REPLAY=false

# Meta Graph API host. Override for staging or sandbox endpoints.
POLARIS_META_CAPI_GRAPH_HOST=graph.facebook.com

# =============================================================================
# Consumer: tiktok v1
# (sync/destinations/tiktok/v1/src/config.ts)
# =============================================================================

POLARIS_TIKTOK_CONSUMER_GROUP=polaris-tiktok-v1
# (A `_CONCURRENCY` knob used to be documented here. It moved to the
# `destinations.max_concurrency` column, per instance, when destinations
# became rows rather than deployments — one vendor can now have two
# instances with different limits, which a deployment-wide variable
# cannot express. Setting the old one did nothing, silently.)
POLARIS_TIKTOK_REQUEST_TIMEOUT_MS=5000
POLARIS_TIKTOK_ALLOW_REPLAY=false

# TikTok Events API host. Override for sandbox endpoints.
POLARIS_TIKTOK_API_HOST=business-api.tiktok.com

# =============================================================================
# Processor: archiver v1
# (async/warehouse/archiver/v1/src/config.ts)
# =============================================================================
#
# Writes raw.events to object storage so replay can reach past the stream's
# ninety-day retention window. Without it, `polaris profiles rebuild` is
# bounded by that window and a five-year customer comes out of an un-merge
# with a first_seen_at of last quarter.
#
# Locally this is the MinIO service in docker-compose.yml; the bucket is
# created for you by the `minio-bucket` one-shot. In production, drop the
# endpoint and path-style vars and let the SDK resolve real S3 from the
# region — credentials come from its own chain (instance role, web
# identity), not from here.

POLARIS_ARCHIVE_BUCKET=polaris-archive
POLARIS_ARCHIVE_PREFIX=polaris
POLARIS_ARCHIVE_S3_REGION=us-east-1
POLARIS_ARCHIVE_S3_ENDPOINT=http://localhost:9002
# MinIO addresses buckets by path; real S3 by subdomain.
POLARIS_ARCHIVE_S3_FORCE_PATH_STYLE=true

# Batch bounds. A batch closes when it hits EITHER, because size alone
# starves a low-traffic project — whose checkpoint then sits still for as
# long as it takes to fill an object — and age alone makes objects
# unbounded under load.
POLARIS_ARCHIVE_MAX_BYTES=8388608
POLARIS_ARCHIVE_MAX_RECORDS=10000
POLARIS_ARCHIVE_MAX_AGE_MS=60000

# How often the flush loop runs. This is what makes the age bound real:
# without a timer, an aged-out batch closes only when the next message on
# the same stream arrives, which on a quiet project is exactly when it
# will not.
POLARIS_ARCHIVE_FLUSH_INTERVAL_MS=5000

POLARIS_ARCHIVE_CONSUMER_GROUP=polaris-archiver-v1

# Local MinIO credentials, read by docker-compose.yml — not by any Polaris
# service. Nothing outside a developer laptop should set these.
MINIO_ROOT_USER=polaris
MINIO_ROOT_PASSWORD=polaris-local-dev
# 9002/9003 rather than MinIO's usual 9000/9001: ClickHouse's native port
# is 9000 and docker-compose.yml publishes it.
MINIO_HOST_PORT=9002
MINIO_CONSOLE_HOST_PORT=9003

# =============================================================================
# Warehouse export
# (apps/polaris-cli/src/commands/warehouse/export.ts)
# =============================================================================
#
# Day-partitioned Parquet extracts. ClickHouse writes the object itself, so
# these are the SERVER's credentials for the bucket, not the CLI's — the CLI
# only passes them through to `INSERT INTO FUNCTION s3(...)`.
#
# Leave the key pair unset when the ClickHouse node has an instance role;
# the two-argument s3() form is used then. Set both or neither: half a pair
# produces an S3 error from deep inside ClickHouse that says nothing about
# which half is missing.

POLARIS_WAREHOUSE_BUCKET_URL=https://s3.eu-west-1.amazonaws.com/polaris-warehouse
# POLARIS_WAREHOUSE_S3_ACCESS_KEY_ID=
# POLARIS_WAREHOUSE_S3_SECRET_ACCESS_KEY=

# =============================================================================
# Reverse ETL (async/reverse-etl/runner/v1, catalog/reverse-etl/)
# =============================================================================
#
# Jobs read ClickHouse projections and POST canonical events to the
# INGESTER — never to raw.events. That costs an HTTP hop for data already
# inside the building, and it is the point: a warehouse row is not more
# trustworthy than an SDK payload just because it came from a database.
# Going through the front door means validation, the forbidden-field
# policy, dedupe and the rate limiter all apply.
#
# Where the runner posts. The ingester's own base URL.
POLARIS_INGEST_URL=http://localhost:4000

# The API key is NOT here. It is an `is_secret` project-config value under
# `reverse_etl.ingest_api_key`, issued for an internal source:
#
#   polaris sources create --project X --env Y --id reverse-etl --type job
#   polaris keys create    --project X --env Y --source reverse-etl --type job
#   polaris config set     --project X --env Y \
#     --key reverse_etl.ingest_api_key --secret --value <token>
#
# Per project, because a key is scoped to one project and environment —
# a deployment-wide variable could not express that even if it wanted to.

# =============================================================================
# `polaris` CLI (apps/polaris-cli)
# =============================================================================
#
# The CLI is an operator tool — it does not run as a service. These
# variables let an operator point the CLI at a control-plane API and
# authenticate as an operator. Production hosts that ship the CLI
# (e.g. bastion / jumphost images) do NOT bake values here; operators
# set them per shell.

# Control-plane API base URL.
POLARIS_API_URL=https://polaris.example.internal

# Bearer token issued by `polaris operators create`. # OBTAIN FROM
# operator's secret manager (1Password, password vault, etc.)
# Operators store this in their shell's env. Never commit.
POLARIS_TOKEN=

# Mutating-command operator credential. Required only for production
# mutations. Same secret as POLARIS_TOKEN in v1.
# OBTAIN FROM operator's secret manager.
POLARIS_OPERATOR_TOKEN=

# Active profile name from ~/.polaris/config.toml. Optional.
POLARIS_PROFILE=

# Output format override: human | json. Optional.
POLARIS_OUTPUT=

# CLI debug toggle; `1` prints stack traces for unhandled errors.
POLARIS_DEBUG=

# Optional override for the location of the catalog/ tree. The CLI walks
# upward from cwd by default.
POLARIS_CATALOG_ROOT=

# =============================================================================
# Smoke tests (tests/smoke/vertical-slice.test.ts)
# =============================================================================
#
# These are operator/CI variables that gate the Docker-backed smoke
# test. Not consumed by any service. Listed here for completeness so
# operators know they exist.

# Set to `1` to actually run the Docker-backed smoke test. Defaults
# unset, which skips the file (keeping `pnpm test` cheap).
POLARIS_SMOKE_DOCKER=

# Project ID the smoke test asserts against. Defaults to `storefront`.
POLARIS_SMOKE_PROJECT_ID=

# Environment label the smoke test asserts against. Defaults to `development`.
POLARIS_SMOKE_ENVIRONMENT=

# Poll timeout for the smoke vertical slice, milliseconds. Defaults to 60000.
POLARIS_SMOKE_POLL_TIMEOUT_MS=

# =============================================================================
# Secrets
# =============================================================================
#
# There is nothing to configure here, and that is the point.
#
# This section used to declare POLARIS_SECRET_PROVIDER and a Vault adapter
# block: destination credentials and per-project secrets were stored in
# PostgreSQL as `<provider>:<ref>` pointers, and an adapter resolved them at
# the point of use. Both now live in the control-plane database as plaintext
# (db/migrations/20260813000004_plaintext_project_secrets.sql), so nothing
# resolves anything and the adapters were removed.
#
# Where secrets live now:
#
#   - a destination's vendor credential -> `destinations.secret_value`, set
#     with `polaris destinations create --secret-value` and replaced with
#     `polaris destinations rotate-secret`. Write-only: no CLI verb, page or
#     export prints it back.
#   - a project's own sensitive variables -> `project_config`, set with
#     `polaris config set --secret` or the admin UI's Variables panel, and
#     read back only with `polaris config get --reveal`.
#   - APP / DEPLOYMENT credentials (the Postgres password, the broker
#     password, ClickHouse) -> this file and the process environment, as they
#     always were. A service reads them at bootstrap, before it can reach any
#     store.
#
# The consequence, stated where an operator provisioning a deployment will see
# it: access to the control-plane database is access to every project's vendor
# accounts. Restrict it, and treat its backups as credential material.
