<?xml version="1.0"?>
<!--
  Polaris ClickHouse macros: production profile.

  Mount this file into the ClickHouse container at
  /etc/clickhouse-server/config.d/macros.xml in production.

  The cluster name, shard, and replica should be templated at deploy
  time (Kubernetes ConfigMap, Helm values, or equivalent). The
  default_replica_path / default_replica_name elements let Replicated
  engines work with the minimal engine spec from sql/clickhouse/ —
  the DDL only passes the version column, never the ZK path.
-->
<clickhouse>
    <macros>
        <!-- Cluster name. Must match the <remote_servers> entry in
             the cluster topology config. -->
        <cluster>polaris</cluster>

        <!-- {replicated} expands to 'Replicated' so e.g.
             `{replicated}ReplacingMergeTree(_version)` becomes
             `ReplicatedReplacingMergeTree(_version)`. -->
        <replicated>Replicated</replicated>

        <!-- Shard/replica identities. Templated per host at deploy
             time. For the v1 single-shard, single-replica
             deployment these are constant ('01' and the host name);
             they vary per replica once we scale out. -->
        <shard>01</shard>
        <replica from_env="HOSTNAME">replica01</replica>
    </macros>

    <!--
      Replicated* engines need a ZooKeeper/Keeper path and a replica
      name. Setting these defaults at the server level lets every
      Replicated* table use the shorthand engine spec from
      sql/clickhouse/ without repeating the path on every CREATE
      TABLE statement.

      The path includes {shard} so adding a second shard later does
      not collide with the first shard's metadata.
    -->
    <default_replica_path>/clickhouse/tables/{shard}/{database}/{table}</default_replica_path>
    <default_replica_name>{replica}</default_replica_name>
</clickhouse>
