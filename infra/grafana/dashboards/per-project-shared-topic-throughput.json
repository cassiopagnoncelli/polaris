  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "polaris-prometheus" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "content": "# Per-project share of shared-topic throughput\n\nUses the Polaris topic-family labels `project_id`, `environment`, `topic_family`, and `concrete_topic`. The 25%-of-shared-throughput line is the documented isolation trigger.\n\n- Use `polaris topics isolate --project <id> --env <env> --family <name>` once the trigger has persisted for one operational review cycle.\n- Use `polaris topics deisolate ...` to roll back once the trigger has resolved for a documented period.",
        "mode": "markdown"
      },
      "pluginVersion": "11.4.0",
      "title": "About this dashboard",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "polaris-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "polaris-prometheus" },
          "expr": "sum by (project_id) (rate(polaris_ingest_batch_accepted_total{topic_family=\"$topic_family\", environment=\"$environment\", concrete_topic=\"$topic_family\"}[5m]))",
          "legendFormat": "{{project_id}}",
          "refId": "A"
        }
      ],
      "title": "Shared-topic throughput by project_id (per 5m)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "polaris-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.15 },
              { "color": "red", "value": 0.25 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "polaris-prometheus" },
          "expr": "sum by (project_id) (rate(polaris_ingest_batch_accepted_total{topic_family=\"$topic_family\", environment=\"$environment\", concrete_topic=\"$topic_family\"}[15m])) / ignoring(project_id) group_left() sum(rate(polaris_ingest_batch_accepted_total{topic_family=\"$topic_family\", environment=\"$environment\", concrete_topic=\"$topic_family\"}[15m]))",
          "legendFormat": "{{project_id}}",
          "refId": "A"
        }
      ],
      "title": "Per-project share of shared-topic throughput (15m)",
      "type": "stat"
    }
  ],
