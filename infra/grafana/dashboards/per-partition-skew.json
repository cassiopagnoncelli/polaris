  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "polaris-prometheus" },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "content": "# Per-partition skew on shared topics, grouped by project_id\n\nUses the Polaris topic-family labels `project_id`, `environment`, `topic_family`, `concrete_topic`, `partition`. A repeatedly-hot partition for one project is the volume-share isolation trigger.\n\n- The partition key for `raw.events` is `<project_id>:<environment>:<identity>`. A project whose identity distribution collapses onto one key hot-spots one partition.\n- Use `polaris topics isolate --project <id> --env <env> --family <name>` once the hot-partition pattern has persisted for one operational review cycle.",
        "mode": "markdown"
      },
      "pluginVersion": "11.4.0",
      "title": "About this dashboard",
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "polaris-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "displayMode": "lcd" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 4 },
      "id": 2,
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "polaris-prometheus" },
          "expr": "sum by (project_id, partition) (rate(polaris_processor_events_consumed_total{topic_family=\"$topic_family\", environment=\"$environment\", concrete_topic=\"$topic_family\"}[5m]))",
          "legendFormat": "{{project_id}} - p{{partition}}",
          "refId": "A"
        }
      ],
      "title": "Per-(project_id, partition) consumer throughput on $topic_family",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "polaris-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 5 },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "polaris-prometheus" },
          "expr": "sum by (partition) (rate(polaris_processor_events_consumed_total{topic_family=\"$topic_family\", environment=\"$environment\", concrete_topic=\"$topic_family\", project_id=\"$project_id\"}[5m]))",
          "legendFormat": "partition {{partition}}",
          "refId": "A"
        }
      ],
      "title": "Per-partition skew over time (filtered to $project_id)",
      "type": "timeseries"
    }
