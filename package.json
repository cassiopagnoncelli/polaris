{
  "name": "polaris",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Polaris internal multi-project event infrastructure platform",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit && pnpm -r --if-present run typecheck",
    "lint": "biome lint . && pnpm lint:clickhouse-imports && pnpm lint:nul-bytes && pnpm lint:dead-exports && pnpm lint:process-env && pnpm lint:project-config-keys && pnpm lint:metric-names",
    "lint:fix": "biome lint --write .",
    "lint:clickhouse-imports": "node scripts/lint-clickhouse-imports.mjs",
    "lint:nul-bytes": "node scripts/lint-nul-bytes.mjs",
    "lint:dead-exports": "node scripts/lint-dead-exports.mjs",
    "lint:process-env": "node scripts/lint-process-env.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "pretest": "pnpm build",
    "test": "vitest run --passWithNoTests && pnpm test:scripts",
    "test:watch": "vitest",
    "test:scripts": "vitest run --root scripts --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "pnpm -r --if-present run clean",
    "db:bootstrap-local": "node scripts/postgres-bootstrap-local.mjs",
    "db:destroy-local": "node scripts/postgres-bootstrap-local.mjs --destroy",
    "db:migrate": "pnpm --filter @polaris/shared-db db:migrate",
    "db:rollback": "pnpm --filter @polaris/shared-db db:rollback",
    "db:status": "pnpm --filter @polaris/shared-db db:status",
    "db:create": "pnpm --filter @polaris/shared-db db:create",
    "clickhouse:migrate": "node scripts/clickhouse-migrate.mjs",
    "clickhouse:migrate:dry-run": "node scripts/clickhouse-migrate.mjs --dry-run",
    "clickhouse:bootstrap-local": "node scripts/clickhouse-bootstrap-local.mjs",
    "clickhouse:destroy-local": "node scripts/clickhouse-bootstrap-local.mjs --destroy",
    "clickhouse:query": "node scripts/clickhouse-query.mjs",
    "redis:destroy-local": "node scripts/redis-destroy-local.mjs",
    "rabbitmq:bootstrap-local": "node scripts/rabbitmq-bootstrap-local.mjs",
    "rabbitmq:provision": "node scripts/rabbitmq-provision.mjs",
    "rabbitmq:provision:dry-run": "node scripts/rabbitmq-provision.mjs --dry-run",
    "rabbitmq:destroy": "node scripts/rabbitmq-provision.mjs --destroy",
    "openapi": "pnpm -r --if-present --filter @polaris/ingester-api... run build && node scripts/openapi-generate.mjs",
    "openapi:check": "pnpm -r --if-present --filter @polaris/ingester-api... run build && node scripts/openapi-generate.mjs --check",
    "config-schemas": "node scripts/project-config-schemas-generate.mjs",
    "config-schemas:check": "node scripts/project-config-schemas-generate.mjs --check",
    "smoke:vertical-slice": "node scripts/smoke/vertical-slice.mjs",
    "test:smoke": "POLARIS_SMOKE_DOCKER=1 vitest run --root . tests/smoke",
    "test:integration": "POLARIS_INTEGRATION=1 vitest run --root . tests/integration",
    "test:acceptance": "node scripts/run-acceptance.mjs",
    "docker:build": "node scripts/docker-build.mjs",
    "docker:build:list": "node scripts/docker-build.mjs --list",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "lint:project-config-keys": "node scripts/lint-project-config-keys.mjs",
    "lint:metric-names": "node scripts/lint-metric-names.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@polaris/shared-control-plane-db": "workspace:*",
    "@polaris/shared-db": "workspace:*",
    "@polaris/shared-secrets": "workspace:*",
    "@polaris/shared-transport": "workspace:*",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.6",
    "amqplib": "^2.0.1",
    "tsx": "^4.20.3",
    "typescript": "6.0.3",
    "uuid": "^14.0.0",
    "vitest": "4.1.6",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
