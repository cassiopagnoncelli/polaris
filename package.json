{
  "name": "polaris",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Polaris internal multi-project event infrastructure platform",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit && pnpm -r --if-present run typecheck",
    "lint": "biome lint . && pnpm lint:clickhouse-imports",
    "lint:fix": "biome lint --write .",
    "lint:clickhouse-imports": "node scripts/lint-clickhouse-imports.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run --passWithNoTests && pnpm test:scripts",
    "test:watch": "vitest",
    "test:scripts": "vitest run --root scripts --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "pnpm -r --if-present run clean",
    "db:migrate": "pnpm --filter @polaris/shared-db db:migrate",
    "db:rollback": "pnpm --filter @polaris/shared-db db:rollback",
    "db:status": "pnpm --filter @polaris/shared-db db:status",
    "db:create": "pnpm --filter @polaris/shared-db db:create",
    "clickhouse:migrate": "node scripts/clickhouse-migrate.mjs",
    "clickhouse:migrate:dry-run": "node scripts/clickhouse-migrate.mjs --dry-run",
    "clickhouse:bootstrap-local": "node scripts/clickhouse-bootstrap-local.mjs",
    "clickhouse:query": "node scripts/clickhouse-query.mjs",
    "openapi": "pnpm --filter @polaris/ingester-api run build && node scripts/openapi-generate.mjs",
    "openapi:check": "pnpm --filter @polaris/ingester-api run build && node scripts/openapi-generate.mjs --check",
    "smoke:vertical-slice": "node scripts/smoke/vertical-slice.mjs",
    "test:smoke": "POLARIS_SMOKE_DOCKER=1 vitest run --root . tests/smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.6",
    "typescript": "6.0.3",
    "vitest": "4.1.6",
    "yaml": "2.9.0"
  }
}
