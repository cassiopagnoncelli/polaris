{
  "name": "@polaris/processor-identity-resolver-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Polaris identity-resolver processor v1. Consumes raw.events, detects authoritative identity overlaps (anonymous_id + customer_id co-occurrence), persists links to the identity_links table, and emits identity.linked/merged/rotated events on identity.events.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "processor.manifest.yaml",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "POLARIS_SERVICE_NAME=identity-resolver POLARIS_HTTP_PORT=4011 tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@polaris/shared-config": "workspace:*",
    "@polaris/shared-db": "workspace:*",
    "@polaris/shared-kafka": "workspace:*",
    "@polaris/shared-logger": "workspace:*",
    "@polaris/shared-metrics": "workspace:*",
    "@polaris/shared-processor": "workspace:*",
    "@polaris/shared-schemas": "workspace:*",
    "@polaris/shared-service-bootstrap": "workspace:*",
    "kysely": "^0.29.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  }
}
