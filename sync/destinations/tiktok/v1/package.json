{
  "name": "@polaris/consumer-tiktok-v1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Polaris TikTok Events API destination consumer v1. Maps canonical Polaris events into TikTok's Events API payload shape (user/properties with hashed identifiers) and POSTs them to business-api.tiktok.com/open_api/<version>/event/track/ with Access-Token header auth. Second real-vendor consumer; clones the directory shape established by sync/destinations/meta-capi/v1.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "consumer.manifest.yaml",
    "SPEC.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "POLARIS_SERVICE_NAME=tiktok POLARIS_HTTP_PORT=5003 tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@polaris/runtime-config": "workspace:*",
    "@polaris/persistence-postgres": "workspace:*",
    "@polaris/delivery-normalize": "workspace:*",
    "@polaris/delivery-host": "workspace:*",
    "@polaris/delivery-destinations": "workspace:*",
    "@polaris/observability-logger": "workspace:*",
    "@polaris/observability-metrics": "workspace:*",
    "@polaris/tenancy-project-config": "workspace:*",
    "@polaris/runtime-service-bootstrap": "workspace:*",
    "@polaris/bus": "workspace:*",
    "kysely": "^0.29.0",
    "zod": "^4.4.3"
  }
}
