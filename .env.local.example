# Polaris bare-metal local-dev env file.
#
# Copy to `.env.local` (already gitignored) and adjust if your local
# Postgres / Redis / ClickHouse / Redpanda are not on the defaults below.
# `packages/shared-config` auto-loads `.env.local` ahead of `.env`, so every
# service picks these up without per-app wiring.
#
# Production NEVER reads this file — production hosts inject env vars through
# the orchestrator (see `.env.example` header and docs/deployment/README.md).
#
# Defaults match docker-compose.yml so you can mix-and-match (compose for
# infra, `make dev` for the apps) without touching anything.

# Shared service identity. Each service's pnpm `dev` script also sets
# `POLARIS_SERVICE_NAME` and `POLARIS_HTTP_PORT` to the canonical per-service
# values from `infra/docker/README.md`, so you should not set them here.
POLARIS_ENV=local
POLARIS_LOG_LEVEL=info
POLARIS_LOG_PRETTY=true

# HTTP server bind host (every service)
POLARIS_HTTP_HOST=127.0.0.1

# PostgreSQL
POLARIS_POSTGRES_HOST=localhost
POLARIS_POSTGRES_PORT=5432
POLARIS_POSTGRES_DATABASE=polaris
POLARIS_POSTGRES_USER=polaris
POLARIS_POSTGRES_PASSWORD=polaris
POLARIS_POSTGRES_SSL=false

# dbmate (db-migrate / db-rollback / db-status) reads DATABASE_URL.
DATABASE_URL=postgres://polaris:polaris@localhost:5432/polaris?sslmode=disable

# Redis
POLARIS_REDIS_HOST=localhost
POLARIS_REDIS_PORT=6379

# Redpanda / Kafka
POLARIS_REDPANDA_BROKERS=localhost:19092
POLARIS_REDPANDA_CLIENT_ID=polaris-local
POLARIS_REDPANDA_SSL=false

# ClickHouse
POLARIS_CLICKHOUSE_URL=http://localhost:8123
POLARIS_CLICKHOUSE_DATABASE=polaris
POLARIS_CLICKHOUSE_SERVICE_USER=polaris_service
POLARIS_CLICKHOUSE_SERVICE_PASSWORD=polaris_service

# CLI convenience (operators talking to a local control-plane)
POLARIS_API_URL=http://localhost:4001
