# Polaris bare-metal local-dev env file.
#
# Copy to `.env.local` (already gitignored) and adjust if your local
# Postgres / Redis / ClickHouse / RabbitMQ are not on the defaults below.
# `packages/shared-config` auto-loads `.env.local` ahead of `.env`, so every
# service picks these up without per-app wiring.
#
# Production NEVER reads this file — production hosts inject env vars through
# the orchestrator (see `.env.example` header and docs/deployment/README.md).
#
# Defaults match docker-compose.yml so you can mix-and-match (compose for
# infra, `make dev` for the apps) without touching anything.

# Shared service identity. Each service's pnpm `dev` script also sets
# `POLARIS_SERVICE_NAME` and `POLARIS_HTTP_PORT` to the canonical per-service
# values from `infra/docker/README.md`, so you should not set them here.
POLARIS_ENV=local
POLARIS_LOG_LEVEL=info
POLARIS_LOG_PRETTY=true

# HTTP server bind host (every service)
POLARIS_HTTP_HOST=127.0.0.1

# PostgreSQL
POLARIS_POSTGRES_HOST=localhost
POLARIS_POSTGRES_PORT=5432
POLARIS_POSTGRES_DATABASE=polaris
POLARIS_POSTGRES_USER=polaris
POLARIS_POSTGRES_PASSWORD=polaris
POLARIS_POSTGRES_SSL=false

# dbmate (db-migrate / db-rollback / db-status) reads DATABASE_URL.
DATABASE_URL=postgres://polaris:polaris@localhost:5432/polaris?sslmode=disable

# Redis
POLARIS_REDIS_HOST=localhost
POLARIS_REDIS_PORT=6379

# RabbitMQ
POLARIS_RABBITMQ_URL=amqp://polaris:polaris@localhost:5672
POLARIS_RABBITMQ_MANAGEMENT_URL=http://localhost:15672
POLARIS_RABBITMQ_CLIENT_ID=polaris-local
POLARIS_RABBITMQ_TLS=false
POLARIS_RABBITMQ_PARTITIONS=3
POLARIS_RABBITMQ_PARTITION_OVERRIDES=raw.events=6

# ClickHouse
POLARIS_CLICKHOUSE_URL=http://localhost:8123
POLARIS_CLICKHOUSE_DATABASE=polaris
POLARIS_CLICKHOUSE_SERVICE_USER=polaris_service
POLARIS_CLICKHOUSE_SERVICE_PASSWORD=polaris_service
# ClickHouse no longer reaches the broker at all: consumers/clickhouse-sink
# consumes analytics.events and INSERTs batches, so there is nothing to
# point ClickHouse at.
#
# The sink authenticates as its own write-only role rather than reusing
# `polaris_service` — see infra/clickhouse/init/01_local_users.sql, which
# creates the local user with this password. Both vars are REQUIRED by
# consumers/clickhouse-sink: without them the service exits at boot with a
# config-validation error, and `make dev-all` comes up one consumer short.
POLARIS_CLICKHOUSE_SINK_USER=polaris_sink
POLARIS_CLICKHOUSE_SINK_PASSWORD=polaris_sink

# Extra browser origins for `make seed` (bin/setup), comma-separated.
#
# The ingester checks the `Origin` header of browser-sent batches against a
# per-source allow-list and denies anything unknown, so a browser app has to
# be on the list before its events are accepted. The seed already covers
# samples/01-web-events on its documented port (http://localhost:3000); set
# this when you run a browser app somewhere else, then re-run `make seed`.
#
# Development only, and never `*` — a wildcard would defeat the check.
# POLARIS_DEV_ORIGINS=http://localhost:5173,http://localhost:4321

# ---------------------------------------------------------------------------
# Admin UI (control-plane-api, http://localhost:4001/admin)
# ---------------------------------------------------------------------------
#
# Nothing here is required for local development. The defaults match the Idp
# development seed (`~/src/idp/db/seeds/development/oauth_applications.rb`,
# client `polaris_development`), so `make dev-control-plane` plus a running
# Idp on :3011 is enough to sign in.
#
# Sign-in requires an Idp account with a platform role of `admin` or `owner`.
# Grant one at http://localhost:3011/admin/users.
#
# In staging and production BOTH secrets below are required, and the
# development values are refused — the service fails at boot rather than at
# the first sign-in attempt.
#
# IDP_BASE_URL=http://localhost:3011
# IDP_CLIENT_ID=polaris_development
# IDP_CLIENT_SECRET=polaris_dev_secret
#
# Signs the admin identity cookie, whose email becomes audit_records.actor_label.
# Must be >= 32 characters outside local/development.
# POLARIS_ADMIN_SESSION_SECRET=
#
# Must match a registered redirect_uri at Idp byte-for-byte — the match is
# exact-string, not prefix, and a mismatch 400s before any redirect happens.
# IDP_REDIRECT_URI=http://localhost:4001/admin/auth/callback
#
# Minimum platform role for mutating a row whose environment is `production`.
# The entry bar is `admin`; this escalates above it. Set to `admin` to disable
# the distinction. owner | admin | member | viewer | none
# POLARIS_ADMIN_PRODUCTION_MIN_ROLE=owner
