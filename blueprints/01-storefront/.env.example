# Copy to `.env.local`. You do not need to paste any tokens: `make setup`
# issues both and writes them to `blueprints/api-key`, which `next.config.ts`
# reads for any value this file leaves unset. Anything you do set here wins.
#
# Two keys, because this blueprint produces from two sources. The web key
# sends as `storefront-web` and is publishable; the backend key sends as
# `payments-api` and is a secret. Keeping them apart is what lets a query
# separate "the browser said so" from "the server confirmed it".
#
# To reissue by hand — each token prints exactly once, and only an argon2id
# hash is stored, so a lost token is reissued and never recovered:
#
#   make api_key                                          # web key
#   make api_key KEY_SOURCE=payments-api KEY_TYPE=backend  # backend key

POLARIS_ENDPOINT=http://localhost:4000/v1/events

# ---------------------------------------------------------------------------
# Browser events. The same web key appears twice on purpose — the two
# transports differ in exactly one thing, which of these you fill in.
# ---------------------------------------------------------------------------

# `direct` mode: inlined into the JS bundle and sent from the tab. That is
# correct for a web key — the ingester scopes it to the origin allow-list and
# rate limits it per key — and never correct for a backend key. Leave it
# empty to run relay-only; direct mode then reports itself unavailable
# instead of pretending.
#
# This is the one key NOT filled in from `blueprints/api-key`. Setting it
# puts a token in the JS bundle, which is a decision about what is
# publishable — the decision this blueprint exists to teach. Paste the web
# token from `blueprints/api-key` here when you want to see direct mode.
NEXT_PUBLIC_POLARIS_API_KEY=

# `relay` mode: read by `app/api/polaris/events/route.ts` and attached
# server-side. No NEXT_PUBLIC_ prefix, so it never reaches the browser.
# Filled in from `blueprints/api-key` when left empty.
POLARIS_WEB_API_KEY=

# Which transport a fresh browser starts on: `direct` or `relay`. The switch
# on /transport overrides it per browser and remembers the choice.
NEXT_PUBLIC_POLARIS_TRANSPORT=direct

# A label the ingester overwrites with the identifier bound to the key. Kept
# honest anyway — it shows up in logs before the key is resolved.
NEXT_PUBLIC_POLARIS_SOURCE_ID=storefront-web

# ---------------------------------------------------------------------------
# Backend events. Server-side only, always — a backend key is not
# origin-scoped and not rate-limited the way a web key is.
# ---------------------------------------------------------------------------

# Filled in from `blueprints/api-key` when left empty.
POLARIS_BACKEND_API_KEY=
POLARIS_BACKEND_SOURCE_ID=payments-api
